# Frontend Environment Variables (Vite)
# Copy this file to .env and update with your actual values
# Note: Vite only exposes variables prefixed with VITE_ to the client

# API Configuration
# In development, the proxy in vite.config.js handles this
# In production, set this to your deployed backend URL (e.g., https://api.yourdomain.com/api)
VITE_API_BASE_URL=http://localhost:5001/api

# ML Service URL (for direct calls if needed)
# In production, set to your deployed ML service URL
VITE_ML_SERVICE_URL=http://localhost:8000

# Application Configuration
VITE_APP_NAME=GlucoMind
VITE_APP_VERSION=1.0.0

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ADVANCED_METRICS=true

# Production URLs (examples)
# VITE_API_BASE_URL=https://api.glucomind.com/api
# VITE_ML_SERVICE_URL=https://ml.glucomind.com
