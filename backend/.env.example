# Backend Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration
# For local development: mongodb://localhost:27017/glucomind
# For MongoDB Atlas (production): mongodb+srv://<username>:<password>@cluster.mongodb.net/glucomind?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/glucomind

# Security
# IMPORTANT: Generate a strong, unique JWT secret for production
# You can use: openssl rand -base64 64
JWT_SECRET=glucomind_secret_key_change_in_production

# ML Service Configuration
ML_SERVICE_URL=http://localhost:8000

# CORS Configuration (optional)
# CORS_ORIGIN=https://yourdomain.com

# API Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
