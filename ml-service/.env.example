# ML Service Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Number of worker processes (for production, use CPU count)
WORKERS=1

# Logging Level: debug, info, warning, error, critical
LOG_LEVEL=info

# Model Configuration
MODEL_PATH=./models/glucose_predictor.joblib
METADATA_PATH=./models/model_metadata.json

# CORS Configuration
# In production, restrict this to your frontend domain
# Example: CORS_ORIGINS=["https://glucomind.com","https://www.glucomind.com"]
CORS_ORIGINS=["*"]

# Application Settings
APP_NAME=GlucoMind ML Service
APP_VERSION=1.0.0
ENVIRONMENT=production

# Performance Settings
MAX_REQUEST_SIZE=10485760
TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_MODEL_RETRAINING=false
ENABLE_ADVANCED_PREDICTIONS=true

# Optional: Database for logging predictions (if needed)
# DB_URI=postgresql://user:password@localhost/mldb
